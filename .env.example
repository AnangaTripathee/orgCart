# Copy to .env.local and fill in. Never commit real values.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# orgCart refuses any other value: only the sandbox is supported.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Signs checkout bindings (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHECKOUT_SIGNING_SECRET=replace-with-a-random-32-plus-character-value
